# ==========================================================================
# strat.conf — semua knob bot di satu tempat.
#
# Cara pakai:
#   - Salin file ini: cp strat.conf.example strat.conf
#   - Edit, simpan. Perubahan dipakai otomatis di siklus berikutnya
#     (maksimal ~POLL_INTERVAL_MS), tanpa restart dan tanpa redeploy.
#   - Format: KEY=value, satu per baris. Komentar pakai #.
#   - Nilai di sini MENANG atas .env dan atas default di kode.
#   - Kalau ada baris yang salah, nilainya diabaikan (nilai lama tetap
#     dipakai) dan alasannya muncul di log: "strat.conf ignored a value".
#   - Cek nilai efektif: node dist/index.js --show-config
# ==========================================================================

# --- GMGN / pacing --------------------------------------------------------
# Jangan turunkan GMGN_MIN_GAP_MS di bawah 1000: bucket IP GMGN ~5 unit dan
# terisi ~1 unit/detik. Di bawah itu pernah kena ban 30 detik.
GMGN_BASE_URL=https://openapi.gmgn.ai
# GMGN_API_KEY=            # biarkan di .env
GMGN_MIN_GAP_MS=1000
GMGN_MAX_GAP_MS=5000
GMGN_RANK_SETTLE_MS=800

# --- Telegram -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=      # biarkan di .env
# TELEGRAM_CHAT_ID=        # biarkan di .env

# --- Sumber trending ------------------------------------------------------
# 1m | 5m | 1h | 6h | 24h
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume

# --- Filter (semua hard filter, harus lolos semua) ------------------------
MIN_AGE_HOURS=48
MIN_MARKET_CAP=2000000
MIN_TOTAL_FEE_SOL=60
# Ambang volume 5 menit (USD). Token >= ambang ini jadi RUNNER dan dikirim
# real-time; di bawahnya masuk WATCHLIST (dikirim tiap REPORT_WINDOW_MINUTES).
# 0 = semua token yang lolos filter dianggap runner.
MIN_VOL5M_USD=30000
# TVL minimal di Meteora (DLMM + DAMM v2) dalam USD. 0 = filter dimatikan.
# Hanya likuiditas Meteora yang dihitung; likuiditas di DEX lain tidak.
MIN_TVL_USD=20000
# 0.995 = dianggap ATH kalau MC >= 99.5% rekor tertinggi.
ATH_TOLERANCE=0.995

# --- Siklus ---------------------------------------------------------------
# Jeda antar siklus setelah siklus sebelumnya selesai.
POLL_INTERVAL_MS=30000
# Batas token yang dicek per siklus (sisanya menyusul siklus berikutnya).
MAX_CANDIDATES_PER_CYCLE=25
# Cooldown alert RUNNER (real-time). Watchlist tidak memakai cooldown ini.
COOLDOWN_MINUTES=60
# true = cetak alert ke log, tidak kirim ke Telegram.
DRY_RUN=false
# Butuh restart (koneksi SQLite dibuka saat start).
DB_PATH=data/bot.db

# --- Cache (menghemat kuota API) ------------------------------------------
INFO_CACHE_MS=55000
SECURITY_CACHE_MS=3600000
METEORA_CACHE_MS=300000

# --- Format pesan ---------------------------------------------------------
# digest = runner real-time + watchlist tiap N menit
# individual = hanya runner real-time, watchlist tidak dikirim
REPORT_MODE=digest
# Kirim watchlist tiap N menit (0 = tiap siklus).
REPORT_WINDOW_MINUTES=30
# Batas token per pesan watchlist (runner tidak dibatasi).
WATCHLIST_MAX=20
REPORT_TIMEZONE=Asia/Jakarta
REPORT_TZ_LABEL=WIB
