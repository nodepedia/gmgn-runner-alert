# GMGN OpenAPI key (https://gmgn.ai/ai)
GMGN_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# One or more chat IDs, comma separated
TELEGRAM_CHAT_ID=

# Scan
POLL_INTERVAL_MS=60000
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume

# Filters
MIN_AGE_HOURS=48
MIN_MARKET_CAP=2000000
MIN_TOTAL_FEE_SOL=60

# Alert cooldown per token (minutes)
COOLDOWN_MINUTES=60

# ATH tag tolerance (0.995 = within 0.5% of ATH)
ATH_TOLERANCE=0.995

# GMGN pacing: one request in flight, 1000ms apart (~1 rps).
# The measured IP bucket refills at ~1 unit/s; faster pacing drains it and
# earns a 30s ban. The pacer backs off further (up to GMGN_MAX_GAP_MS) on 429.
GMGN_MIN_GAP_MS=1000
GMGN_MAX_GAP_MS=5000
# market/rank is the heaviest call; let the bucket refill before token calls.
GMGN_RANK_SETTLE_MS=800

# Enrichment cache TTLs
INFO_CACHE_MS=55000
SECURITY_CACHE_MS=3600000
METEORA_CACHE_MS=300000

# Fairness cap per cycle (pacing keeps the cycle short either way)
MAX_CANDIDATES_PER_CYCLE=25

# Debug
DRY_RUN=false
DB_PATH=data/bot.db
