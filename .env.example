# ==========================================================================
# This file only carries SECRETS (and acts as fallback defaults).
# All tuning knobs can live in strat.conf, which overrides anything here and
# is reloaded automatically after each edit. See strat.conf.example.
# Optional: point to a different strat file.
# STRAT_FILE=/opt/gmgn-runner-alert/strat.conf
# ==========================================================================

# GMGN OpenAPI key (https://gmgn.ai/ai)
GMGN_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# One or more chat IDs, comma separated
TELEGRAM_CHAT_ID=

# Scan
POLL_INTERVAL_MS=30000
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume

# Filters
MIN_AGE_HOURS=48
MIN_MARKET_CAP=2000000
MIN_TOTAL_FEE_SOL=60
# 5m volume threshold (USD): above = runner (real-time), below = watchlist.
MIN_VOL5M_USD=30000
# Watchlist floor (USD): below this the token is not reported at all (0 = off)
MIN_WATCHLIST_VOL5M_USD=5000
# Only alert tokens with at least this much Meteora TVL (DLMM + DAMM v2), USD (0 = off)
MIN_TVL_USD=20000

# Runner alert cooldown (minutes); the watchlist ignores it
COOLDOWN_MINUTES=60

# ATH tag tolerance (0.995 = within 0.5% of ATH)
ATH_TOLERANCE=0.995

# Runner Supertrend gate. Default candles are Meteora DLMM OHLCV (highest-TVL
# DLMM pool from the TVL fetch). GMGN /v1/market/token_kline is optional.
# Bearish does not alert and does not start the cooldown.
# SUPERTREND_ON_ERROR: skip (default) or allow. SUPERTREND_WATCHLIST gates the
# digest too when true. SUPERTREND_FALLBACK_GMGN spends a GMGN kline only when
# Meteora has no DLMM pool or the OHLCV call fails.
SUPERTREND_ENABLED=true
SUPERTREND_SOURCE=meteora
SUPERTREND_FALLBACK_GMGN=false
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=3
SUPERTREND_TIMEFRAME=5m
SUPERTREND_CANDLES=60
SUPERTREND_ON_ERROR=skip
SUPERTREND_WATCHLIST=false
SUPERTREND_CACHE_MS=240000

# GMGN pacing: one request in flight, 1000ms apart (~1 rps).
# The measured IP bucket refills at ~1 unit/s; faster pacing drains it and
# earns a 30s ban. The pacer backs off further (up to GMGN_MAX_GAP_MS) on 429.
GMGN_MIN_GAP_MS=1000
GMGN_MAX_GAP_MS=5000
# market/rank is the heaviest call; let the bucket refill before token calls.
GMGN_RANK_SETTLE_MS=800

# Enrichment cache TTLs
INFO_CACHE_MS=55000
SECURITY_CACHE_MS=3600000
METEORA_CACHE_MS=300000

# Fairness cap per cycle (pacing keeps the cycle short either way)
MAX_CANDIDATES_PER_CYCLE=25

# Report: digest = runner real-time + watchlist every N minutes
# individual = runner real-time only (no watchlist)
REPORT_MODE=digest
REPORT_WINDOW_MINUTES=30
WATCHLIST_MAX=20
REPORT_TIMEZONE=Asia/Jakarta
REPORT_TZ_LABEL=WIB

# Debug
DRY_RUN=false
DB_PATH=data/bot.db
