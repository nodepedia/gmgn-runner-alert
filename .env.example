# GMGN OpenAPI key (https://gmgn.ai/ai)
GMGN_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# One or more chat IDs, comma separated
TELEGRAM_CHAT_ID=

# Scan
POLL_INTERVAL_MS=60000
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume

# Filters
MIN_AGE_HOURS=48
MIN_MARKET_CAP=2000000
MIN_TOTAL_FEE_SOL=60

# Alert cooldown per token (minutes)
COOLDOWN_MINUTES=60

# ATH tag tolerance (0.995 = within 0.5% of ATH)
ATH_TOLERANCE=0.995

# GMGN pacing: one request in flight, 300ms apart (~3.3 rps).
# The pacer backs off automatically (up to GMGN_MAX_GAP_MS) if GMGN ever 429s.
GMGN_MIN_GAP_MS=300
GMGN_MAX_GAP_MS=2000

# Enrichment cache TTLs
INFO_CACHE_MS=55000
SECURITY_CACHE_MS=3600000
METEORA_CACHE_MS=300000

# Fairness cap per cycle (pacing keeps the cycle short either way)
MAX_CANDIDATES_PER_CYCLE=40

# Debug
DRY_RUN=false
DB_PATH=data/bot.db
