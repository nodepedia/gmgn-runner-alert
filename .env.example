# GMGN OpenAPI key (https://gmgn.ai/ai)
GMGN_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# One or more chat IDs, comma separated
TELEGRAM_CHAT_ID=

# Scan
POLL_INTERVAL_MS=60000
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume

# Filters
MIN_AGE_HOURS=48
MIN_MARKET_CAP=2000000
MIN_TOTAL_FEE_SOL=60

# Alert cooldown per token (minutes)
COOLDOWN_MINUTES=60

# ATH tag tolerance (0.995 = within 0.5% of ATH)
ATH_TOLERANCE=0.995

# Rate limit (GMGN free plan = 5/5)
GMGN_RATE_PER_SEC=5
GMGN_BURST=5

# Enrichment cache
FEE_CACHE_MS=600000
SECURITY_CACHE_MS=3600000
MAX_CANDIDATES_PER_CYCLE=30

# Debug
DRY_RUN=false
DB_PATH=data/bot.db
