{
  "name": "gmgn-runner-alert",
  "version": "1.0.0",
  "description": "Telegram alert bot for Solana runners trending on GMGN with Meteora TVL enrichment",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "once": "node dist/index.js --once",
    "warmup": "node dist/index.js --warmup",
    "test:telegram": "node dist/index.js --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/supertrend.test.js dist/ohlcv.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
